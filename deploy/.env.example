POSTGRES_PASSWORD=
# The accounts the API and workers use. Make each one different.
APP_DB_PASSWORD=
PUSH_DB_PASSWORD=
IMPORTS_DB_PASSWORD=
# 16 characters or more. Only works while the database has no users.
BOOTSTRAP_INVITE_CODE=
# The docker network your tunnel or reverse proxy runs on.
EDGE_NETWORK=
# Workers to run, comma separated: push sends phone notifications, imports brings in sessions from apps
# like Lyfta. See the README.
COMPOSE_PROFILES=
# For notifications in the web app. Make them with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Where push services can reach you, like mailto:you@example.com
WEB_PUSH_SUBJECT=
# For importing from other apps. Make them with: npm run sealing-keys -w @sandbag/api
# The API gets the public half and can only lock keys. Only the imports worker can open them.
INTEGRATION_PUBLIC_KEY=
INTEGRATION_PRIVATE_KEY=
