{
  "name": "@sandbag/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/pushWorker.ts src/cli/reset-password.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@sandbag/shared=../../packages/shared/src/index.ts --outdir=dist --entry-names=[name]",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev:memory": "tsx src/cli/dev.ts",
    "dev:seed": "tsx src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "@sandbag/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "drizzle-kit": "^0.31.11",
    "esbuild": "*",
    "tsx": "^4.23.15"
  },
  "license": "AGPL-3.0-only"
}
